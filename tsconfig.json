{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "lib": ["ES2023", "DOM"], "types": ["vite/client"],
    "moduleResolution": "bundler", "verbatimModuleSyntax": true, "moduleDetection": "force", "noEmit": true,
    "strict": true, "noImplicitAny": true, "strictNullChecks": true, "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
